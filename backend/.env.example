# Copia este archivo como .env y ajusta los valores para tu entorno.

PORT=4000

# Credenciales del primer usuario administrador (solo se usan la primera
# vez que arranca el servidor, si todavia no existe ningun usuario).
ADMIN_EMAIL=admin@bommain.test
ADMIN_PASSWORD=admin1234

# Secreto usado para firmar la cookie de sesion del panel de administracion.
# Cambialo por un valor aleatorio largo antes de desplegar en produccion.
SESSION_SECRET=cambia-este-valor-por-uno-aleatorio-y-largo
